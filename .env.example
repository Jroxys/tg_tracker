TELEGRAM_BOT_TOKEN=buraya_botfather_tokenini_yapistir

# Opsiyonel: Groq API anahtarı (dinamik/LLM görev üretimi için). Boş bırakılırsa
# bot sabit kelime listesi / süre formülüyle çalışmaya devam eder (fallback).
GROQ_API_KEY=

# Opsiyonel: Groq model adı, varsayılan llama-3.3-70b-versatile
GROQ_MODEL=

# Opsiyonel: Günlük otomatik hatırlatma zamanı (cron formatı, UTC).
# Türkiye UTC+3 sabit (yaz saati uygulaması yok). Varsayılan "0 7 * * *" -> 07:00 UTC = 10:00 TR
REMINDER_CRON=
